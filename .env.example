# Copier ce fichier en .env (non versionné) et renseigner les valeurs.
# Tout ce qui commence par VITE_ est embarqué dans le bundle navigateur : PUBLIC.
# Ne jamais mettre ici de clé secrète (service_role, clés privée/secrète KKiaPay).
# Sur Vercel : mêmes noms, à saisir dans Settings > Environment Variables (puis redéployer).

# Supabase (Project Settings > API) : URL du projet et clé « anon » uniquement
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# KKiaPay : clé PUBLIQUE uniquement
VITE_KKIAPAY_PUBLIC_KEY=
# "true" = bac à sable (paiements fictifs), "false" = production
VITE_KKIAPAY_SANDBOX=true

# Adresse de contact du plan Entreprise (bouton « Contacter les ventes » désactivé si vide)
VITE_CONTACT_EMAIL=
